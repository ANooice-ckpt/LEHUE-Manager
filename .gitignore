# Environment-specific secrets. Commit templates only.
.env
.env.*
!.env.example
!.env.*.example

# Python environments, caches and coverage output.
.venv/
server/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Mutable runtime data. Keep only empty directory markers in Git.
/data/
/server/data/**
!/server/data/.gitkeep

# Backups and local working output.
/backups/
/server/backups/
/tmp/
LEHUE_system_backup_*.zip
lehue_backup_*/
*.db
*.sqlite
*.sqlite3
*.log

# Versioned synthetic TEST baseline. Runtime TEST/PROD data remain ignored.
!/server/test_seed/
!/server/test_seed/**
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Editor and OS metadata.
.DS_Store
.vscode/
.idea/
