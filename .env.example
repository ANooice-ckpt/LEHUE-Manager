# LEHUE = Light Exposure Histories in Urban Environments
PROJECT_NAME=LEHUE
# Local development: localhost. Cloud deployment: e.g. gps-dev.example.com
DOMAIN=localhost

# IMPORTANT: do NOT store LEHUE_ENV here.
# Every server start must explicitly choose test or prod.

# Study calendar used for day-level QC. Raw timestamps are still stored in UTC.
STUDY_TIMEZONE=Asia/Shanghai

# Generate a long random value before use.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_TOKEN
# Fernet key used only to recover GPS passwords and participant portal links.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# Common data root. Runtime selection automatically uses DATA_ROOT/test or DATA_ROOT/prod.
DATA_ROOT=./data
# TEST only: install the Git-versioned synthetic baseline when data/test is absent or empty.
LOAD_TEST_SEED=true
# Lighting raw storage. TEST defaults to local; PROD defaults to and requires oss.
LIGHT_STORAGE_BACKEND=local
# OSS mode only. Use separate buckets and credentials for cloud TEST and PROD.
OSS_BUCKET=
OSS_REGION=cn-hongkong
# Optional override, e.g. an ECS internal endpoint. Otherwise derived from OSS_REGION.
OSS_ENDPOINT=
# Secrets: set real values only in .env or the deployment secret store, never in Git.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Full spectral raw is about 40 MB/person-day; keep some transport headroom.
LIGHT_UPLOAD_MAX_BYTES=67108864

# Convenient during engineering tests; set false for production later.
ENABLE_DOCS=true

# Acquisition-QC engineering thresholds, not final scientific inclusion criteria.
QC_GAP_WARNING_SECONDS=300
QC_DELAY_WARNING_SECONDS=120
QC_POOR_ACCURACY_M=50
