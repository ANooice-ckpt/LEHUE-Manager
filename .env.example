# Public project label only; does not affect the protocol.
PROJECT_NAME=LightTrace
APP_VERSION=0.2.0

# Local development: localhost. Cloud deployment: e.g. gps.example.com
DOMAIN=localhost

# Generate a long random value before cloud deployment.
# Example command: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_TOKEN

# Application paths inside Docker. Local mode can keep these defaults too.
DATA_DIR=./data
DB_PATH=./data/lighttrace.sqlite3
RAW_ARCHIVE_DIR=./data/raw/gps

# Public FastAPI docs are convenient during testing. Set false for production later.
ENABLE_DOCS=true

# QC defaults; these are engineering thresholds, not final scientific inclusion rules.
QC_GAP_WARNING_SECONDS=300
QC_DELAY_WARNING_SECONDS=120
QC_POOR_ACCURACY_M=50
