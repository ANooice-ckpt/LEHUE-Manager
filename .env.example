# LEHUE = Light Exposure Histories in Urban Environments
PROJECT_NAME=LEHUE
# Local development: localhost. Cloud deployment: e.g. gps-dev.example.com
DOMAIN=localhost

# IMPORTANT: do NOT store LEHUE_ENV here.
# Every server start must explicitly choose test or prod.

# Study calendar used for day-level QC. Raw timestamps are still stored in UTC.
STUDY_TIMEZONE=Asia/Shanghai

# Internal compatibility secret; setup scripts generate it automatically.
# Operators do not need to record or use this value.
ADMIN_TOKEN=
# Server-internal Fernet key used to recover GPS passwords and portal links.
# Setup scripts generate it automatically. The service refuses to start without it.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# Common data root. Runtime selection automatically uses DATA_ROOT/test or DATA_ROOT/prod.
DATA_ROOT=./data
# TEST only: install the Git-versioned synthetic baseline when data/test is absent or empty.
LOAD_TEST_SEED=true
# Runtime combinations (LEHUE_ENV remains test/prod; do not invent another environment):
# 1. Windows TEST + local: LIGHT_STORAGE_BACKEND=local, then .\scripts\windows_start.ps1 -Environment test
# 2. ECS TEST + local:     LEHUE_ENV=test LIGHT_STORAGE_BACKEND=local docker compose up -d --build
# 3. ECS TEST + OSS:       LEHUE_ENV=test LIGHT_STORAGE_BACKEND=oss docker compose up -d --build
# Compose defaults to local; set LIGHT_STORAGE_BACKEND=oss explicitly for ECS OSS testing.
# PROD continues to require LIGHT_STORAGE_BACKEND=oss.
LIGHT_STORAGE_BACKEND=local

# OSS mode only. Attach a RAM Role to ECS; do not configure or store long-term AccessKeys.
OSS_BUCKET=
OSS_REGION=cn-hongkong
# Server-side QC/download uses the ECS internal endpoint; browser presigned PUT uses the public endpoint.
# Example for Hong Kong:
# OSS_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
# OSS_PUBLIC_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_CREDENTIAL_MODE=ecs_ram_role
# Optional but recommended on ECS to avoid an extra metadata lookup.
OSS_ROLE_NAME=
OSS_UPLOAD_URL_SECONDS=900
# Automated system backups use a separate private bucket (or a tightly isolated prefix).
BACKUP_OSS_BUCKET=
BACKUP_OSS_PREFIX=lehue-backups
# Full spectral raw is about 40 MB/person-day; keep some transport headroom.
LIGHT_UPLOAD_MAX_BYTES=67108864

# Convenient during engineering tests; set false for production later.
ENABLE_DOCS=true

# Acquisition-QC engineering thresholds, not final scientific inclusion criteria.
QC_GAP_WARNING_SECONDS=300
QC_DELAY_WARNING_SECONDS=120
QC_POOR_ACCURACY_M=50
# OwnTracks Move targets about one record per 10 s; actual cadence may vary or arrive later.
GPS_AUTH_CACHE_SECONDS=300
GPS_BACKFILL_DELAY_SECONDS=900
GPS_DAILY_MIN_POINTS=1000
GPS_DAILY_EDGE_COVERAGE_HOURS=3
GPS_DAILY_MAX_GAP_SECONDS=7200
# Before this local hour, an evening form is assigned to the preceding exposure day.
QUESTIONNAIRE_EVENING_CUTOFF_HOUR=12
# Yesterday remains pending until this local hour, allowing late sleep/wake schedules.
QC_DAY_CLOSE_HOUR=18
# Admin GPS trajectory basemap. Keep attribution required by the tile provider.
GPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
GPS_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
